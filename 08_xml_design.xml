<!-- ============================================================
     XPATH QUERIES
     ============================================================

-- XPath 1: Get all unit IDs dispatched to this incident
/DispatchRecord/UnitAssignments/Unit/UnitID/text()
-- Returns: AMB-021, AMB-034, POL-117

-- XPath 2: Get signal overrides where phase is GREEN
/DispatchRecord/SignalOverrides/Signal[OverridePhase='GREEN']/SignalID/text()
-- Returns: 212, 215

-- XPath 3: Get all closed roads
/DispatchRecord/AffectedRoads/Road[IsClosed='true']/RoadName/text()
-- Returns: Main Sharea Faisal (Northbound)

-- XPath 4: Get ETA for units under 5 minutes
/DispatchRecord/UnitAssignments/Unit[EstimatedETA_min < 5]/UnitID/text()
-- Returns: AMB-021, POL-117

-- XPath 5: Count total dispatched units
count(/DispatchRecord/UnitAssignments/Unit)
-- Returns: 3

============================================================
     XQUERY QUERIES (for XQuery-capable engine / BaseX)
     ============================================================

-- XQuery 1: List all units with ETA and agency, sorted by ETA
for $u in /DispatchRecord/UnitAssignments/Unit
order by $u/EstimatedETA_min ascending
return
  <dispatch>
    <unit>{ string($u/UnitID) }</unit>
    <type>{ string($u/UnitType) }</type>
    <agency>{ string($u/AgencyName) }</agency>
    <eta_min>{ string($u/EstimatedETA_min) }</eta_min>
  </dispatch>

-- XQuery 2: Get signal overrides that are RED with duration > 300s
for $s in /DispatchRecord/SignalOverrides/Signal
where $s/OverridePhase = 'RED' and xs:integer($s/DurationSeconds) > 300
return
  <override signal_id="{ $s/SignalID }">
    <intersection>{ string($s/IntersectionName) }</intersection>
    <reason>{ string($s/Reason) }</reason>
  </override>

-- XQuery 3: Cross-document join — fetch incidents with XML dispatch records
-- (BaseX collection query)
for $doc in collection('dispatch_records')
let $inc_id := $doc/DispatchRecord/IncidentInfo/IncidentID
where xs:integer($inc_id) > 4800
  and $doc/DispatchRecord/IncidentInfo/Severity = 'HIGH'
return
  <summary incident_id="{ $inc_id }"
           dispatch_id="{ $doc/DispatchRecord/@dispatch_id }">
    <zone>{ string($doc/DispatchRecord/IncidentInfo/Location/ZoneName) }</zone>
    <units_dispatched>
      { count($doc/DispatchRecord/UnitAssignments/Unit) }
    </units_dispatched>
  </summary>

============================================================
     POSTGRESQL XML STORAGE (pg/xml functions)
     ============================================================

-- Store XML in PostgreSQL
CREATE TABLE dispatch_xml_store (
    doc_id          SERIAL PRIMARY KEY,
    incident_id     INT REFERENCES incident(incident_id),
    generated_at    TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    xml_document    XML NOT NULL
);

-- Insert sample
INSERT INTO dispatch_xml_store (incident_id, xml_document)
VALUES (4821, XMLPARSE(DOCUMENT '<?xml version="1.0"?> ... '));

-- XPath query inside PostgreSQL
SELECT
    incident_id,
    (xpath('//UnitID/text()', xml_document))[1]::TEXT AS first_unit,
    (xpath('count(//Unit)', xml_document))[1]::TEXT::INT AS unit_count
FROM dispatch_xml_store
WHERE incident_id = 4821;

============================================================ -->
